<jittershader name="particle-render">
    <description>Particle render shader</description>
    <param name="state" type="vec4" state="VERTEX_ATTR0" />
    <param name="modelViewProjectionMatrix" type="mat4" state="MODELVIEW_PROJECTION_MATRIX" />
    <language name="glsl" version="1.5">
        <bind param="state" program="vp" />
        <bind param="modelViewProjectionMatrix" program="vp" />
        <program name="vp" type="vertex">
<![CDATA[
#version 330 core
uniform mat4 modelViewProjectionMatrix;
in vec4 state;      // par instance : xy = pos, zw = vel

out jit_PerVertex {
    flat vec2 vel;
    flat int id;
} jit_out;

void main() {
    gl_Position = modelViewProjectionMatrix * vec4(state.xy, 0., 1.);
    jit_out.vel = state.zw;
    jit_out.id  = gl_VertexID;   
}
]]>
        </program>
        <program name="fp" type="fragment">
<![CDATA[
#version 330 core
in jit_PerVertex {
    flat vec2 vel;
    flat int id;
} jit_in;

layout(location = 0) out vec4 outColor;
layout(location = 1) out vec4 outNormal;

void main() {
    outColor  = jit_in.id < 500000 ? vec4(1.0, 0.0, 0.0, 1.0) : vec4(0.0, 1.0, 0.0, 1.0);
    outNormal = vec4(jit_in.vel, 0.0, 1.0);
}
]]>
        </program>
    </language>
</jittershader>