                                    "text": "in 2"
                                }
                            },
                            {
                                "box": {
                                    "code": "// Physarum trail map, port of the original GLSL canvas pass\n// in1 = agent deposits (brush), hot inlet, only R and G are used\n// in2 = previous trail map (feedback), cold inlet\n\nParam persistence(0.95);  // trail_persistence, clamped to 0..0.999\nParam diffusion(0.5);     // trail_diffusion, clamped to 0.001..1\nParam brush_gain(1.0);    // boosts deposits to compensate for small (1 - P)\nParam clear_trail(0);     // set to 1 for one frame to reset\n\npx = 1.0 / dim;\ndx = vec(px.x, 0);\ndy = vec(0, px.y);\n\n// Slider scaling, same as the original\nd = clamp(diffusion, 0.001, 1);\nd = d * d;\nK = 4 / (pow(5, d) - 1);\nP = clamp(persistence, 0, 0.999);\n\n// 4-neighbour blur with weighted center, applied to the TRAIL (in2)\n// (wrap is the default boundmode)\nblur = sample(in2, norm) * K\n     + sample(in2, norm + dy)\n     + sample(in2, norm - dy)\n     + sample(in2, norm - dx)\n     + sample(in2, norm + dx);\nblur = blur / (4 + K);\n\n// Decay and reinjection: lerp toward the brush value (in1)\nb = sample(in1, norm);\nres = blur * P + (1 - P) * brush_gain * vec(b.x, b.y, 0, 1);\n\nif (clear_trail > 0) {\n    out1 = vec(0, 0, 0, 1);\n} else {\n    out1 = res;\n}",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-3",
                                    "maxclass": "codebox",
                                    "numinlets": 2,
                                    "numoutlets": 1,
                                    "outlettype": [ "" ],
                                    "patching_rect": [ 176.0, 149.0, 586.0, 558.0 ]
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-4",
                                    "maxclass": "newobj",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 176.0, 758.0, 35.0, 22.0 ],
                                    "text": "out 1"
                                }
                            }
                        ],
