                        "text": "function debounce(fn, delay = 300) {\r\n  let timer;\r\n\r\n  const debounced = (...args) => {\r\n    clearTimeout(timer);\r\n    timer = setTimeout(() => fn(...args), delay);\r\n  };\r\n\r\n  debounced.cancel = () => clearTimeout(timer);\r\n\r\n  return debounced;\r\n}\r\n\r\nconst onList = debounce((x, y) => {\n    const aspect = x / y;\r\n    outlet(0, x, y, aspect);\r\n}, 500);\r\n\r\nfunction list(x, y) {\r\n    onList(x, y);\r\n}",
